# Copy to .env (never commit .env). All values below are placeholders.
FLEET_API_KEY=change-me
FLEET_DB_URL=sqlite:///./data/fleet.db
FLEET_DATA_DIR=./data
FLEET_HERMES_HOME=/path/to/hermes-home
FLEET_HERMES_BIN=./scripts/hermes
# Fernet key for service-generated secrets (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FLEET_SECRET_KEY=
# OpenViking (stage 7+)
FLEET_OV_URL=http://127.0.0.1:1933
FLEET_OV_ROOT_KEY=
FLEET_OV_ACCOUNT=team
FLEET_OV_TRUST_ENV=false
